.DS_Store
Thumbs.db
desktop.ini
node_modules/
*.log
.vscode/
.idea/

# Local reference/working images — not part of the app
*.jpg
*.jpeg
package.json
package-lock.json

# Scratch output from a probe or a driver script. `probe-body.tmp` — an empty
# file — was committed in August 2026 and sat in the repo for a week, and this
# site is PUBLIC: anything tracked here is served by GitHub Pages.
*.tmp

# Screenshots taken while working. Two of the app's own screens (record.png,
# sets.png, ~200 KB) were committed the same way and served to the world for
# no reason. Real app art lives in img/ and is committed deliberately.
/*.png

# Python's bytecode cache, left behind by tools/build-body-art.py. Same rule as
# the two above: this site is served from the repo, so anything tracked here is
# published, and a cache directory is not part of the app.
__pycache__/
*.pyc
