rules_version = '2';

// Fitness Tracker — Firestore security rules.
//
// These are the ONLY thing standing between one user's training history and
// everyone else's. The Firebase API key in js/firebase-config.js is not a
// secret and is not a security control — it identifies the project, nothing
// more. Anyone can read it out of the deployed JavaScript. Security comes from
// exactly two places: Firebase Auth proving who the caller is, and this file
// deciding what that caller may touch.
//
// Deploy with:  firebase deploy --only firestore:rules
// Test with:    the Rules Playground in the Firebase console.
//
// Default is deny. Anything not explicitly allowed below is refused, including
// every path that does not appear here at all.

service cloud.firestore {
  match /databases/{database}/documents {

    // The signed-in caller is the owner of this path.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Only the collections the app actually uses. A compromised or modified
    // client cannot invent new ones and use the project as free storage.
    //
    // ⚠️ This list must match COLLECTIONS in js/store.js. A collection added
    // there and not here has every cloud write DENIED while localStorage keeps
    // working — invisible until someone signs in.
    function knownCollection(name) {
      return name in ['customExercises', 'workouts', 'sessions', 'benchmarks', 'settings', 'bodyWeight', 'systems', 'goals', 'guestSessions'];
    }

    // Shape check. The app writes one document per collection, holding the
    // whole row list. Reject anything that is not that shape, and cap the row
    // count so a runaway client cannot push a document toward the 1 MB limit
    // and lock the user out of their own data.
    function validPayload() {
      return request.resource.data.keys().hasOnly(['rows', 'updatedAt'])
          && request.resource.data.rows is list
          && request.resource.data.rows.size() <= 5000
          && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/collections/{name} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && knownCollection(name)
                            && validPayload();
      // Clearing data is a write of an empty list, never a document delete —
      // so nothing needs delete permission.
      allow delete: if false;
    }

    // ================================================================
    // SOCIAL — docs/social-plan.md, Phase 1.
    //
    // ⚠️ READ THIS BEFORE CHANGING ANYTHING ABOVE THIS LINE.
    //
    // The block above is the private data and it stays owner-only forever.
    // Sharing does NOT widen it. It cannot: one document holds every row of a
    // collection, Firestore grants per document, so "let Alex see some of my
    // workouts" is not a permission that exists. Granting read on
    // users/{uid}/collections/sessions grants every session ever recorded.
    //
    // Instead the owner's own client publishes a DERIVED COPY containing only
    // what they chose (js/social.js), and that copy is what other people read.
    // Two independent gates: what goes in is decided at write time by that
    // module, who may read it is decided here. Neither is allowed to become
    // the only one.
    // ================================================================

    function signedIn() {
      return request.auth != null;
    }

    // A published projection. One document per visibility tier.
    //
    // The list of who may read it lives INSIDE the document, so this rule needs
    // no get() of a second document — resource.data is free, a get() is billed
    // on every access and counts against the ten-get limit.
    //
    // ⚠️ `resource` is null on create, which is why create is checked against
    // request.resource and read is checked against resource. Merging the two
    // into one condition makes create fail closed and look like a broken write.
    function isPublishedViewer() {
      return signedIn()
             && resource != null
             && resource.data.viewers is list
             && request.auth.uid in resource.data.viewers;
    }

    function validTier(tier) {
      return tier in ['light', 'mid', 'full'];
    }

    function validProjection() {
      return request.resource.data.keys().hasOnly(
               ['tier', 'viewers', 'profile', 'publishedAt', 'activity',
                'benchmarks', 'strength', 'bodyWeight'])
          && request.resource.data.viewers is list
          && request.resource.data.viewers.size() <= 500
          && request.resource.data.activity is list
          && request.resource.data.activity.size() <= 60;
    }

    match /users/{userId}/shared/{tier} {
      // The owner reads their own to show "here is exactly what Alex can see",
      // which is the answer a copy-based design can give and a permission-based
      // one cannot.
      allow get: if isOwner(userId) || isPublishedViewer();
      // ⚠️ list is DENIED even for viewers. A viewer reads the one tier they
      // were granted, by name. Listing would hand them the names of the tiers
      // they were NOT granted, which is a small leak and an entirely avoidable
      // one.
      allow list: if isOwner(userId);

      allow create, update: if isOwner(userId) && validTier(tier) && validProjection();
      // Unsharing deletes the document. That is the whole revocation mechanism,
      // so it has to be permitted — and it is worth being clear that it is not
      // retroactive: it stops future reads and cannot reach what was already
      // read or screenshotted.
      allow delete: if isOwner(userId);
    }

    // Who the owner is connected to and what each person may see. Owner-only in
    // BOTH directions — this is never how a viewer discovers their own tier.
    match /users/{userId}/social/{doc} {
      allow read, write: if isOwner(userId);
    }

    // Invite links. There is no user directory in v1, deliberately: a
    // searchable list of accounts is an enumeration surface that has to be
    // right first time, and an invite link is a capability handed to one
    // person instead.
    function claimingUnclaimedInvite() {
      // ⚠️ Every field is existence- and type-checked BEFORE it is used, and
      // that is not defensive padding. Rules propagate errors out of an && even
      // when an earlier operand is already false, so reading a field that might
      // be missing turns a clean "denied" into an "evaluation error". Both
      // refuse the write today — but an erroring rule is one whose behaviour
      // depends on operand order, and the next person to add a condition here
      // would be reordering something they cannot see. The emulator run on
      // 2026-08-18 showed exactly this on three of the invite denials.
      return signedIn()
             && resource != null
             && !('claimedBy' in resource.data)
             && 'expiresAt' in resource.data
             && resource.data.expiresAt is timestamp
             && request.time < resource.data.expiresAt
             && 'claimedBy' in request.resource.data
             && request.resource.data.claimedBy == request.auth.uid
             // Only the three claim fields may change. Without this the claimer
             // could rewrite the invite's owner or its expiry on the way past.
             // ⚠️ LOAD-BEARING, and proved so rather than assumed: removing this
             // line on 2026-08-18 made exactly one test flip from denied to
             // ALLOWED — "a claimer cannot extend the expiry on the way past".
             // Without it, redeeming a link is a write the claimer partly
             // controls, and they can push the expiry out while they are in
             // there. Everything else still passed, which is the point: this is
             // the only thing standing between a claim and an edit.
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['claimedBy', 'claimedName', 'claimedAt']);
    }

    // ================================================================
    // REACTIONS — kudos and comments on a friend's published workouts.
    //
    // ⚠️ THE ONE PLACE A SIGNED-IN STRANGER MAY WRITE UNDER ANOTHER
    // PERSON'S UID, and why that is acceptable HERE and nowhere above:
    // the private data ban exists because one document holds a whole
    // collection, so a single bad write replaces a training history. A
    // reaction is ONE DOCUMENT PER REACTION, create-only (update is
    // denied outright), shape-checked below, in a subtree nothing else
    // reads. The worst possible write is one spurious kudos, and the
    // owner can delete it.
    //
    // Who may react: anyone the owner has published ANY tier to. A
    // light-tier viewer sees the workout card in their feed, so they can
    // kudos it — reacting requires exactly the relationship that showed
    // you the thing you are reacting to.
    // ================================================================

    // ⚠️ exists() BEFORE get(), for the same reason claimingUnclaimedInvite
    // checks fields before reading them: an erroring rule is a denial today
    // and a trap for the next person to reorder it. Repeated accesses to the
    // same document count once against the ten-get limit, so this is at most
    // three billed reads on the miss path.
    function viewerOfTier(userId, tier) {
      return exists(/databases/$(database)/documents/users/$(userId)/shared/$(tier))
          && get(/databases/$(database)/documents/users/$(userId)/shared/$(tier)).data.viewers is list
          && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/shared/$(tier)).data.viewers;
    }

    function viewerOfAnyTier(userId) {
      return signedIn()
             && (viewerOfTier(userId, 'light')
              || viewerOfTier(userId, 'mid')
              || viewerOfTier(userId, 'full'));
    }

    function validReaction() {
      return request.resource.data.keys().hasOnly(
               ['kind', 'sessionId', 'from', 'fromName', 'text', 'at'])
          // `from` is PROVEN, not trusted: it must equal the caller's own
          // uid, so a reaction can never be forged in somebody else's name.
          && request.resource.data.from == request.auth.uid
          && request.resource.data.kind in ['kudos', 'comment']
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() >= 1
          && request.resource.data.sessionId.size() <= 80
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          // A kudos carries no words; a comment must carry some. Two kinds,
          // one shape, and this pair of lines is what keeps them honest.
          && (request.resource.data.kind == 'comment' || request.resource.data.text.size() == 0)
          && (request.resource.data.kind == 'kudos' || request.resource.data.text.size() >= 1)
          && request.resource.data.at is timestamp;
    }

    match /users/{userId}/reactions/{reactionId} {
      // The owner reads what landed on their workouts; viewers read so the
      // feed can show counts and threads. list is allowed for viewers —
      // unlike shared/{tier}, there is nothing here a viewer was not meant
      // to see: every document is a reaction to something published to them
      // or to somebody at a laxer tier.
      allow get, list: if isOwner(userId) || viewerOfAnyTier(userId);

      allow create: if viewerOfAnyTier(userId) && validReaction();

      // No update path AT ALL. Editing is delete-and-repost; a kudos toggle
      // is create/delete of a deterministic id. Every mutation a rule does
      // not have is a mutation that cannot be got wrong.
      allow update: if false;

      // The sender can take back their own; the owner can moderate anything
      // on their workouts. Field-guarded like the invite rules: resource is
      // checked before its fields are read.
      allow delete: if isOwner(userId)
                    || (signedIn()
                        && resource != null
                        && 'from' in resource.data
                        && resource.data.from == request.auth.uid);
    }

    // ================================================================
    // HANDOFFS — a session one friend recorded FOR another, offered for
    // them to accept. Open work 0e, the friend half.
    //
    // ⚠️ TIM'S DECISION, AND THE REASON THE WHOLE FEATURE HAS THIS SHAPE:
    // *"the data is saved to each user's specific account"* — but by THEM
    // accepting it, never by a direct write into their training. A direct
    // write would need permission on users/{them}/collections/sessions,
    // and that one document holds every session they have ever recorded,
    // so a single bad write replaces a training history. There is no
    // narrower permission to grant: Firestore grants per document.
    //
    // So this is the reactions pattern again, and it is acceptable for
    // exactly the same reasons: ONE DOCUMENT PER OFFER, create-only,
    // shape-checked, in a subtree nothing else reads. ⚠️ The recipient's
    // own data is never touched by the sender at all — the worst possible
    // write is one unwanted offer sitting in a list, which they delete.
    // Accepting is the RECIPIENT'S OWN CLIENT writing to its own account
    // under the owner-only rules above, entirely unchanged.
    //
    // Who may offer: someone the recipient has published a tier to. That
    // is the same "we are actually connected" test reactions use, and it
    // means a stranger cannot put anything in anybody's list.
    // ================================================================

    // ⚠️ EVERY FIELD IS CHECKED TO EXIST BEFORE IT IS READ, for the reason
    // claimingUnclaimedInvite() spells out above: rules propagate errors out of
    // an && even when an earlier operand is already false, so reading a field
    // that might be missing turns a clean "denied" into an "evaluation error",
    // and an erroring rule behaves according to operand ORDER.
    //
    // ⚠️ AND THE GUARDS DO NOT MAKE THE DIAGNOSTIC GO AWAY — stated because the
    // obvious next move is to keep adding guards until it does. The emulator
    // still logs an evaluation error on these denials AFTER the guards, and so
    // does the reactions block above (L233/L243), which shipped that way on
    // 2026-08-26. The remaining source is the `get()` inside viewerOfAnyTier()
    // on documents that do not exist, not a missing field check. **Every denial
    // is still a denial** — that is what tests/rules.test.mjs asserts and what
    // matters — but do not read a clean run as the goal here, and do not
    // reorder these conditions expecting the log to change.
    function validHandoff() {
      return request.resource.data.keys().hasOnly(
               ['from', 'fromName', 'at', 'session'])
          && 'from' in request.resource.data
          && 'fromName' in request.resource.data
          && 'at' in request.resource.data
          && 'session' in request.resource.data
          // Proven, not trusted — the same line that stops a forged reaction.
          && request.resource.data.from == request.auth.uid
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 60
          && request.resource.data.at is timestamp
          && request.resource.data.session is map
          // A session, not a payload of arbitrary size. The cap is on the
          // shape rather than on bytes because rules cannot measure bytes,
          // and an offer is one workout — if it needs more keys than this
          // it is not a workout.
          && request.resource.data.session.keys().hasOnly(
               ['id', 'date', 'workoutId', 'workoutName', 'startedAt', 'finishedAt',
                'location', 'isBenchmark', 'entries'])
          && 'date' in request.resource.data.session
          && 'entries' in request.resource.data.session
          && request.resource.data.session.date is string
          && request.resource.data.session.date.size() <= 30
          && request.resource.data.session.entries is list
          && request.resource.data.session.entries.size() <= 40;
    }

    match /users/{userId}/handoffs/{handoffId} {
      // Owner-only reading. Unlike reactions there is nothing here for a
      // viewer to see — an offer is addressed to one person.
      allow get, list: if isOwner(userId);

      allow create: if viewerOfAnyTier(userId) && validHandoff();

      // No update path at all, for the reason the reactions block gives:
      // every mutation a rule does not have is one that cannot be got wrong.
      // Changing an offer means retracting it and sending another.
      allow update: if false;

      // The recipient deletes on accept or decline; the sender can retract
      // one they should not have sent. Field-guarded before its fields are
      // read, like every other rule here.
      allow delete: if isOwner(userId)
                    || (signedIn()
                        && resource != null
                        && 'from' in resource.data
                        && resource.data.from == request.auth.uid);
    }

    // ================================================================
    // DISCONNECTS — "I have left, take me off your list." Open work 0j.
    //
    // ⚠️ WHAT THIS FIXES: social.remove() edits only the leaver's OWN
    // graph, so the other person's published copy still listed them in
    // `viewers` and they could go on reading that person's training after
    // pressing Disconnect. The sheet was corrected on 2026-08-24 to stop
    // promising otherwise, which was not the same as fixing it.
    //
    // ⚠️ AND WHY IT IS A TOMBSTONE RATHER THAN AN EDIT. The obvious fix is
    // for the leaver to remove themselves from the other person's viewers
    // list — and that means write permission on users/{them}/shared/{tier},
    // which is the document holding their whole published projection. One
    // bad write there destroys what every one of their friends can see. So
    // the leaver instead drops a note that they have gone, and the OWNER'S
    // client acts on it, republishing without them.
    //
    // ⚠️ THE HONEST LIMIT, WHICH THE SHEET MUST STATE: this is EVENTUAL.
    // Until the other person's app next opens and processes the note, the
    // leaver is still in their viewers list. What is immediate is the
    // leaver's own side. Anything stronger needs a server, which this app
    // does not have (docs/integrations-plan.md §2 makes the same point
    // from the other direction).
    // ================================================================

    match /users/{userId}/disconnects/{leaverId} {
      // The owner reads them to act on them. Nobody else needs to.
      allow get, list: if isOwner(userId);

      // ⚠️ THE DOCUMENT ID *IS* THE CALLER'S UID, and that is the whole
      // access control: you may announce your OWN departure and nobody
      // else's. Without it, anybody connected could evict anybody else.
      // It also makes the write idempotent — pressing Disconnect twice
      // writes the same document.
      // Fields checked to exist before they are read — see validHandoff().
      allow create, update: if signedIn()
                            && leaverId == request.auth.uid
                            && request.resource.data.keys().hasOnly(['from', 'at'])
                            && 'from' in request.resource.data
                            && 'at' in request.resource.data
                            && request.resource.data.from == request.auth.uid
                            && request.resource.data.at is timestamp;

      // The owner deletes it once acted on; the leaver can withdraw it if
      // they reconnect before it was processed.
      allow delete: if isOwner(userId) || leaverId == request.auth.uid;
    }

    match /users/{userId}/invites/{token} {
      // ⚠️ get YES, list NO, and that distinction is the whole security model
      // here. Anyone signed in can redeem a link they were GIVEN — they must be
      // able to read it to redeem it — but nobody can enumerate anyone's
      // invites, so a leaked link costs one invite rather than the whole set.
      allow get: if signedIn();
      allow list: if isOwner(userId);

      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(
                         ['token', 'createdAt', 'expiresAt', 'claimedBy', 'claimedName', 'claimedAt'])
                    && !('claimedBy' in request.resource.data);
      allow update: if isOwner(userId) || claimingUnclaimedInvite();
      allow delete: if isOwner(userId);
    }
  }
}
