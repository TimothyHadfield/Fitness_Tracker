rules_version = '2';

// Fitness Tracker — Firestore security rules.
//
// These are the ONLY thing standing between one user's training history and
// everyone else's. The Firebase API key in js/firebase-config.js is not a
// secret and is not a security control — it identifies the project, nothing
// more. Anyone can read it out of the deployed JavaScript. Security comes from
// exactly two places: Firebase Auth proving who the caller is, and this file
// deciding what that caller may touch.
//
// Deploy with:  firebase deploy --only firestore:rules
// Test with:    the Rules Playground in the Firebase console.
//
// Default is deny. Anything not explicitly allowed below is refused, including
// every path that does not appear here at all.

service cloud.firestore {
  match /databases/{database}/documents {

    // The signed-in caller is the owner of this path.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Only the collections the app actually uses. A compromised or modified
    // client cannot invent new ones and use the project as free storage.
    //
    // ⚠️ This list must match COLLECTIONS in js/store.js. A collection added
    // there and not here has every cloud write DENIED while localStorage keeps
    // working — invisible until someone signs in.
    function knownCollection(name) {
      return name in ['customExercises', 'workouts', 'sessions', 'benchmarks', 'settings', 'bodyWeight', 'systems', 'goals', 'guestSessions', 'people'];
    }

    // Shape check. The app writes one document per collection, holding the
    // whole row list. Reject anything that is not that shape, and cap the row
    // count so a runaway client cannot push a document toward the 1 MB limit
    // and lock the user out of their own data.
    function validPayload() {
      return request.resource.data.keys().hasOnly(['rows', 'updatedAt'])
          && request.resource.data.rows is list
          && request.resource.data.rows.size() <= 5000
          && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId}/collections/{name} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && knownCollection(name)
                            && validPayload();
      // Clearing data is a write of an empty list, never a document delete —
      // so nothing needs delete permission.
      allow delete: if false;
    }

    // ================================================================
    // SHARDED COLLECTIONS — one document per row, for the two that grow
    // without limit. Open work 0b(c).
    //
    // ⚠️ WHAT THIS FIXES: the block above puts a whole collection in ONE
    // document, and Firestore caps a document at 1 MiB. At the measured
    // ~2,000 bytes a session that is about 520 sessions — two and a half
    // years at four a week — after which saving a workout fails. Sessions
    // and guest sessions now live one per document instead, where the only
    // limit is the collection's, and Firestore does not cap that.
    //
    // ⚠️ THIS IS STILL OWNER-ONLY AND NOTHING HERE WIDENS ANYTHING. It is
    // the same private training data under a different path shape. In
    // particular it does NOT make per-session sharing possible: the social
    // design publishes a derived copy precisely so that "let Alex see some
    // of my workouts" never becomes a read permission on real sessions,
    // and a sharded layout is not an invitation to revisit that.
    //
    // ⚠️ AND `delete` IS ALLOWED HERE, WHERE IT IS DENIED ABOVE. That is
    // the one genuine permission difference and it is forced: removing a
    // session used to be a write of a shorter list, and is now a document
    // delete. The blast radius is one row rather than a collection, which
    // is the direction this change moves everything.
    //
    // The name check is what stops a modified client using the project as
    // free storage under an invented subcollection — the same job
    // knownCollection() does above. It must match SHARDED_COLLECTIONS in
    // js/firebase-backend.js.
    // ================================================================

    function validShardPayload() {
      return request.resource.data.keys().hasOnly(['row', 'updatedAt'])
          && request.resource.data.row is map
          && request.resource.data.updatedAt is timestamp;
    }

    // ⚠️ `read` HERE MEANS `get` AND `list`, AND SINCE 2026-09-08 IT ALSO
    // CARRIES AN AGGREGATION QUERY. The client asks `where updatedAt > cursor`
    // plus `getCountFromServer` on every sync so that opening the app costs
    // what CHANGED rather than a whole training history — the cost finding in
    // docs/running-costs.html. Narrowing this to `get` would not merely break
    // the count; it would break every read of a sharded collection.
    match /users/{userId}/sessions/{rowId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validShardPayload();
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/guestSessions/{rowId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validShardPayload();
      allow delete: if isOwner(userId);
    }

    // ================================================================
    // BACKUPS — users/{uid}/backups/*, 2026-08-28. Safety copies of the
    // account's own collections, written by the owner's client: a 7-day
    // rolling ring (`rolling-{weekday}-{collection}`) plus immutable
    // snapshots taken before the two flows allowed to wipe wholesale
    // (`snap-{stamp}-{collection}`). Exists because a migration emptied
    // the sessions document on 2026-08-26 and there was no copy to reach
    // for. Owner-only in every direction — a backup of private data is
    // exactly as private as the data.
    //
    // ⚠️ `snap-*` DOCUMENTS CANNOT BE UPDATED, BY ANYONE. A pre-wipe
    // snapshot that the wipe itself could overwrite protects nothing.
    // The rolling ring must be updatable — overwriting last Tuesday IS
    // the pruning — so mutability follows the id prefix.
    // ================================================================

    function validBackup() {
      return request.resource.data.keys().hasOnly(
               ['collection', 'part', 'rows', 'reason', 'at', 'updatedAt'])
          && request.resource.data.rows is list;
    }

    match /users/{userId}/backups/{backupId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validBackup();
      allow update: if isOwner(userId) && validBackup()
                    && backupId.matches('rolling-.*');
      allow delete: if isOwner(userId);
    }

    // ================================================================
    // SOCIAL — docs/social-plan.md, Phase 1.
    //
    // ⚠️ READ THIS BEFORE CHANGING ANYTHING ABOVE THIS LINE.
    //
    // The block above is the private data and it stays owner-only forever.
    // Sharing does NOT widen it. It cannot: one document holds every row of a
    // collection, Firestore grants per document, so "let Alex see some of my
    // workouts" is not a permission that exists. Granting read on
    // users/{uid}/collections/sessions grants every session ever recorded.
    //
    // Instead the owner's own client publishes a DERIVED COPY containing only
    // what they chose (js/social.js), and that copy is what other people read.
    // Two independent gates: what goes in is decided at write time by that
    // module, who may read it is decided here. Neither is allowed to become
    // the only one.
    // ================================================================

    function signedIn() {
      return request.auth != null;
    }

    // A published projection. 🚨 ONE DOCUMENT PER AUDIENCE since 2026-09-03,
    // where there used to be one per visibility tier — `friends` and `public`.
    // Tim: *"you can either make your account private so only friends you accept
    // can see, or public so anyone on the app that finds your account can see
    // all details."*
    //
    // The list of who may read the friends document lives INSIDE it, so this
    // rule needs no get() of a second document — resource.data is free, a get()
    // is billed on every access and counts against the ten-get limit.
    //
    // ⚠️ `resource` is null on create, which is why create is checked against
    // request.resource and read is checked against resource. Merging the two
    // into one condition makes create fail closed and look like a broken write.
    function isPublishedViewer() {
      return signedIn()
             && resource != null
             && resource.data.viewers is list
             && request.auth.uid in resource.data.viewers;
    }

    // 🚨 THE PUBLIC READ, AND IT IS THE WIDEST GRANT IN THIS FILE. It is gated
    // on a field the OWNER's own client wrote, which is the same shape as
    // `viewers` — a document says who may read it, and only its owner may write
    // it. `isPublic` is set by js/social.js from the audience rather than from a
    // caller's argument, and assertAudienceClean() refuses to hand back a
    // friends document carrying it.
    //
    // ⚠️ SIGNED IN IS REQUIRED. "Anyone on the app" is what Tim asked for, and
    // an unauthenticated read is not that — it is the whole internet with a
    // scraper, and it would also make every read unattributable.
    function isPublicDoc() {
      return signedIn()
             && resource != null
             && resource.data.isPublic == true;
    }

    function validAudience(audience) {
      return audience in ['friends', 'public'];
    }

    function validProjection() {
      // 🚨 `connections` JOINED THIS LIST ON 2026-09-16 AND THE ORDER OF DEPLOY
      // IS THE WHOLE POINT. `hasOnly` refuses a document carrying a key it does
      // not name, so shipping the client that publishes a friends list while
      // this line still said nine fields would have denied EVERY publish —
      // silently, because republish() is called fire-and-forget and its throw is
      // swallowed at every call site. The symptom would have been "nobody's page
      // updates any more" with nothing on any screen saying so. Rules go out
      // with the client, never after it.
      return request.resource.data.keys().hasOnly(
               ['audience', 'isPublic', 'viewers', 'profile', 'publishedAt', 'activity',
                'benchmarks', 'strength', 'bodyWeight', 'connections'])
          && request.resource.data.viewers is list
          && request.resource.data.viewers.size() <= 500
          && request.resource.data.activity is list
          && request.resource.data.activity.size() <= 60
          // The same treatment `viewers` and `activity` get: a type and a
          // ceiling, so a runaway write is refused on the wire rather than
          // trusted to the builder's own cap (MAX_CONNECTIONS, js/social.js).
          // ⚠️ It is checked only where present: an account that has not
          // republished since this shipped has no such key, and a rule that
          // required one would refuse the delete-and-rewrite path those
          // documents still need.
          && (!('connections' in request.resource.data)
              || (request.resource.data.connections is list
                  && request.resource.data.connections.size() <= 500))
          // ⚠️ THE ONE FIELD THE PUBLIC DOCUMENT MAY NOT HOLD, enforced on the
          // wire as well as in the builder. Body weight reaches accepted friends
          // only (Tim, 2026-09-03), and this is the gate that survives a bug in
          // js/social.js rather than trusting it — the same two-independent-gates
          // discipline the whole sharing model rests on.
          && (request.resource.data.isPublic != true
              || !('bodyWeight' in request.resource.data));
    }

    match /users/{userId}/shared/{audience} {
      // The owner reads their own to show "here is exactly what a friend can
      // see", which is the answer a copy-based design can give and a
      // permission-based one cannot.
      allow get: if isOwner(userId) || isPublishedViewer() || isPublicDoc();
      // ⚠️ list is DENIED even for viewers, and it still matters with two
      // documents: listing would tell a stranger reading a public account that a
      // friends document exists and how many people are in it.
      allow list: if isOwner(userId);

      allow create, update: if isOwner(userId) && validAudience(audience) && validProjection();
      // Unsharing deletes the document. That is the whole revocation mechanism
      // — going private deletes the public copy — so it has to be permitted, and
      // it is worth being clear that it is not retroactive: it stops future
      // reads and cannot reach what was already read or screenshotted.
      //
      // ⚠️ THE LEGACY TIER DOCUMENTS ARE DELETED THROUGH THIS SAME RULE. An
      // account that published before 2026-09-03 has light/mid/full documents
      // whose `viewers` lists are live grants that nothing reads any more;
      // store.js clears them on the first publish after the change. `delete` is
      // deliberately not narrowed by validAudience — you must be able to delete
      // a document you are no longer allowed to write.
      allow delete: if isOwner(userId);
    }

    // Who the owner is connected to. Owner-only in BOTH directions.
    match /users/{userId}/social/{doc} {
      allow read, write: if isOwner(userId);
    }

    // Invite links. There is no user directory in v1, deliberately: a
    // searchable list of accounts is an enumeration surface that has to be
    // right first time, and an invite link is a capability handed to one
    // person instead.
    function claimingUnclaimedInvite() {
      // ⚠️ Every field is existence- and type-checked BEFORE it is used, and
      // that is not defensive padding. Rules propagate errors out of an && even
      // when an earlier operand is already false, so reading a field that might
      // be missing turns a clean "denied" into an "evaluation error". Both
      // refuse the write today — but an erroring rule is one whose behaviour
      // depends on operand order, and the next person to add a condition here
      // would be reordering something they cannot see. The emulator run on
      // 2026-08-18 showed exactly this on three of the invite denials.
      return signedIn()
             && resource != null
             && !('claimedBy' in resource.data)
             && 'expiresAt' in resource.data
             && resource.data.expiresAt is timestamp
             && request.time < resource.data.expiresAt
             && 'claimedBy' in request.resource.data
             && request.resource.data.claimedBy == request.auth.uid
             // Only the three claim fields may change. Without this the claimer
             // could rewrite the invite's owner or its expiry on the way past.
             // ⚠️ LOAD-BEARING, and proved so rather than assumed: removing this
             // line on 2026-08-18 made exactly one test flip from denied to
             // ALLOWED — "a claimer cannot extend the expiry on the way past".
             // Without it, redeeming a link is a write the claimer partly
             // controls, and they can push the expiry out while they are in
             // there. Everything else still passed, which is the point: this is
             // the only thing standing between a claim and an edit.
             && request.resource.data.diff(resource.data)
                  .affectedKeys().hasOnly(['claimedBy', 'claimedName', 'claimedAt']);
    }

    // ================================================================
    // REACTIONS — kudos and comments on a friend's published workouts.
    //
    // ⚠️ THE ONE PLACE A SIGNED-IN STRANGER MAY WRITE UNDER ANOTHER
    // PERSON'S UID, and why that is acceptable HERE and nowhere above:
    // the private data ban exists because one document holds a whole
    // collection, so a single bad write replaces a training history. A
    // reaction is ONE DOCUMENT PER REACTION, create-only (update is
    // denied outright), shape-checked below, in a subtree nothing else
    // reads. The worst possible write is one spurious kudos, and the
    // owner can delete it.
    //
    // 🚨 WHO MAY REACT: AN ACCEPTED FRIEND, AND ONLY AN ACCEPTED FRIEND.
    // It used to be a viewer of any tier. When the account model became
    // private/public on 2026-09-03 this deliberately did NOT follow it:
    // Tim asked that a public account be READABLE by anyone signed in,
    // and letting anyone signed in also write into that account's
    // reactions subtree is a different feature — it is the moderation
    // surface, and this project has no moderation story (see
    // docs/social-plan.md §12.11, which refuses the discovery feed on
    // exactly those grounds). A stranger reads a public account and
    // leaves nothing on it. Reversing that is this one function.
    // ================================================================

    // ⚠️ exists() BEFORE get(), for the same reason claimingUnclaimedInvite
    // checks fields before reading them: an erroring rule is a denial today
    // and a trap for the next person to reorder it. Repeated accesses to the
    // same document count once against the ten-get limit, so this is ONE
    // billed read now rather than three — the tiers are gone and there is a
    // single document to consult.
    function isFriendOf(userId) {
      return signedIn()
          && exists(/databases/$(database)/documents/users/$(userId)/shared/friends)
          && get(/databases/$(database)/documents/users/$(userId)/shared/friends).data.viewers is list
          && request.auth.uid in get(/databases/$(database)/documents/users/$(userId)/shared/friends).data.viewers;
    }

    function validReaction() {
      return request.resource.data.keys().hasOnly(
               ['kind', 'sessionId', 'from', 'fromName', 'text', 'at'])
          // `from` is PROVEN, not trusted: it must equal the caller's own
          // uid, so a reaction can never be forged in somebody else's name.
          && request.resource.data.from == request.auth.uid
          && request.resource.data.kind in ['kudos', 'comment']
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() >= 1
          && request.resource.data.sessionId.size() <= 80
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          // A kudos carries no words; a comment must carry some. Two kinds,
          // one shape, and this pair of lines is what keeps them honest.
          && (request.resource.data.kind == 'comment' || request.resource.data.text.size() == 0)
          && (request.resource.data.kind == 'kudos' || request.resource.data.text.size() >= 1)
          && request.resource.data.at is timestamp;
    }

    match /users/{userId}/reactions/{reactionId} {
      // The owner reads what landed on their workouts; friends read so the
      // feed can show counts and threads. list is allowed for friends —
      // unlike shared/{audience}, there is nothing here a friend was not
      // meant to see: every document is a reaction to something published
      // to them.
      //
      // ⚠️ A STRANGER READING A PUBLIC ACCOUNT SEES NO KUDOS AND NO
      // COMMENTS, which follows from reacting being friends-only: what
      // they would be reading is a conversation between people who know
      // each other, on a page they are merely allowed to look at.
      allow get, list: if isOwner(userId) || isFriendOf(userId);

      allow create: if isFriendOf(userId) && validReaction();

      // No update path AT ALL. Editing is delete-and-repost; a kudos toggle
      // is create/delete of a deterministic id. Every mutation a rule does
      // not have is a mutation that cannot be got wrong.
      allow update: if false;

      // The sender can take back their own; the owner can moderate anything
      // on their workouts. Field-guarded like the invite rules: resource is
      // checked before its fields are read.
      allow delete: if isOwner(userId)
                    || (signedIn()
                        && resource != null
                        && 'from' in resource.data
                        && resource.data.from == request.auth.uid);
    }

    // ================================================================
    // HANDOFFS — a session one friend recorded FOR another, offered for
    // them to accept. Open work 0e, the friend half.
    //
    // ⚠️ TIM'S DECISION, AND THE REASON THE WHOLE FEATURE HAS THIS SHAPE:
    // *"the data is saved to each user's specific account"* — but by THEM
    // accepting it, never by a direct write into their training. A direct
    // write would need permission on users/{them}/collections/sessions,
    // and that one document holds every session they have ever recorded,
    // so a single bad write replaces a training history. There is no
    // narrower permission to grant: Firestore grants per document.
    //
    // So this is the reactions pattern again, and it is acceptable for
    // exactly the same reasons: ONE DOCUMENT PER OFFER, create-only,
    // shape-checked, in a subtree nothing else reads. ⚠️ The recipient's
    // own data is never touched by the sender at all — the worst possible
    // write is one unwanted offer sitting in a list, which they delete.
    // Accepting is the RECIPIENT'S OWN CLIENT writing to its own account
    // under the owner-only rules above, entirely unchanged.
    //
    // Who may offer: someone the recipient has published a tier to. That
    // is the same "we are actually connected" test reactions use, and it
    // means a stranger cannot put anything in anybody's list.
    // ================================================================

    // ⚠️ EVERY FIELD IS CHECKED TO EXIST BEFORE IT IS READ, for the reason
    // claimingUnclaimedInvite() spells out above: rules propagate errors out of
    // an && even when an earlier operand is already false, so reading a field
    // that might be missing turns a clean "denied" into an "evaluation error",
    // and an erroring rule behaves according to operand ORDER.
    //
    // ⚠️ AND THE GUARDS DO NOT MAKE THE DIAGNOSTIC GO AWAY — stated because the
    // obvious next move is to keep adding guards until it does. The emulator
    // still logs an evaluation error on these denials AFTER the guards, and so
    // does the reactions block above (L233/L243), which shipped that way on
    // 2026-08-26. The remaining source is the `get()` inside isFriendOf()
    // on documents that do not exist, not a missing field check. **Every denial
    // is still a denial** — that is what tests/rules.test.mjs asserts and what
    // matters — but do not read a clean run as the goal here, and do not
    // reorder these conditions expecting the log to change.
    function validHandoff() {
      return request.resource.data.keys().hasOnly(
               ['from', 'fromName', 'at', 'session'])
          && 'from' in request.resource.data
          && 'fromName' in request.resource.data
          && 'at' in request.resource.data
          && 'session' in request.resource.data
          // Proven, not trusted — the same line that stops a forged reaction.
          && request.resource.data.from == request.auth.uid
          && request.resource.data.fromName is string
          && request.resource.data.fromName.size() <= 60
          && request.resource.data.at is timestamp
          && request.resource.data.session is map
          // A session, not a payload of arbitrary size. The cap is on the
          // shape rather than on bytes because rules cannot measure bytes,
          // and an offer is one workout — if it needs more keys than this
          // it is not a workout.
          && request.resource.data.session.keys().hasOnly(
               ['id', 'date', 'workoutId', 'workoutName', 'startedAt', 'finishedAt',
                'location', 'isBenchmark', 'entries'])
          && 'date' in request.resource.data.session
          && 'entries' in request.resource.data.session
          && request.resource.data.session.date is string
          && request.resource.data.session.date.size() <= 30
          && request.resource.data.session.entries is list
          && request.resource.data.session.entries.size() <= 40;
    }

    match /users/{userId}/handoffs/{handoffId} {
      // Owner-only reading. Unlike reactions there is nothing here for a
      // viewer to see — an offer is addressed to one person.
      allow get, list: if isOwner(userId);

      // ⚠️ FRIENDS ONLY, and more obviously so than reactions: handing somebody
      // a whole workout to accept into their own training is not something a
      // stranger who can merely read a public account gets to do.
      allow create: if isFriendOf(userId) && validHandoff();

      // No update path at all, for the reason the reactions block gives:
      // every mutation a rule does not have is one that cannot be got wrong.
      // Changing an offer means retracting it and sending another.
      allow update: if false;

      // The recipient deletes on accept or decline; the sender can retract
      // one they should not have sent. Field-guarded before its fields are
      // read, like every other rule here.
      allow delete: if isOwner(userId)
                    || (signedIn()
                        && resource != null
                        && 'from' in resource.data
                        && resource.data.from == request.auth.uid);
    }

    // ================================================================
    // DISCONNECTS — "I have left, take me off your list." Open work 0j.
    //
    // ⚠️ WHAT THIS FIXES: social.remove() edits only the leaver's OWN
    // graph, so the other person's published copy still listed them in
    // `viewers` and they could go on reading that person's training after
    // pressing Disconnect. The sheet was corrected on 2026-08-24 to stop
    // promising otherwise, which was not the same as fixing it.
    //
    // ⚠️ AND WHY IT IS A TOMBSTONE RATHER THAN AN EDIT. The obvious fix is
    // for the leaver to remove themselves from the other person's viewers
    // list — and that means write permission on users/{them}/shared/{tier},
    // which is the document holding their whole published projection. One
    // bad write there destroys what every one of their friends can see. So
    // the leaver instead drops a note that they have gone, and the OWNER'S
    // client acts on it, republishing without them.
    //
    // ⚠️ THE HONEST LIMIT, WHICH THE SHEET MUST STATE: this is EVENTUAL.
    // Until the other person's app next opens and processes the note, the
    // leaver is still in their viewers list. What is immediate is the
    // leaver's own side. Anything stronger needs a server, which this app
    // does not have (docs/integrations-plan.md §2 makes the same point
    // from the other direction).
    // ================================================================

    match /users/{userId}/disconnects/{leaverId} {
      // The owner reads them to act on them. Nobody else needs to.
      allow get, list: if isOwner(userId);

      // ⚠️ THE DOCUMENT ID *IS* THE CALLER'S UID, and that is the whole
      // access control: you may announce your OWN departure and nobody
      // else's. Without it, anybody connected could evict anybody else.
      // It also makes the write idempotent — pressing Disconnect twice
      // writes the same document.
      // Fields checked to exist before they are read — see validHandoff().
      allow create, update: if signedIn()
                            && leaverId == request.auth.uid
                            && request.resource.data.keys().hasOnly(['from', 'at'])
                            && 'from' in request.resource.data
                            && 'at' in request.resource.data
                            && request.resource.data.from == request.auth.uid
                            && request.resource.data.at is timestamp;

      // The owner deletes it once acted on; the leaver can withdraw it if
      // they reconnect before it was processed.
      allow delete: if isOwner(userId) || leaverId == request.auth.uid;
    }

    match /users/{userId}/invites/{token} {
      // ⚠️ get YES, list NO, and that distinction is the whole security model
      // here. Anyone signed in can redeem a link they were GIVEN — they must be
      // able to read it to redeem it — but nobody can enumerate anyone's
      // invites, so a leaked link costs one invite rather than the whole set.
      allow get: if signedIn();
      allow list: if isOwner(userId);

      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(
                         ['token', 'createdAt', 'expiresAt', 'claimedBy', 'claimedName', 'claimedAt'])
                    && !('claimedBy' in request.resource.data);
      allow update: if isOwner(userId) || claimingUnclaimedInvite();
      allow delete: if isOwner(userId);
    }

    // ================================================================
    // FRIEND REQUESTS — "add me", which they accept. 2026-08-29.
    //
    // Modelled on disconnects above, deliberately, and NOT put inside
    // `invites`: that collection allows `get` to anyone signed in (a link
    // must be readable to be redeemed), so a request living there would let
    // anybody holding two uids read whether A had asked B. An invite is a
    // capability I ISSUED; a request is something somebody asked OF me.
    // Two meanings in one collection is how the read rule ends up wrong.
    //
    // ⚠️ ACCEPTANCE NEEDS NO RULE AT ALL, and that is the nicest part of
    // this design. When the owner accepts, they add the requester to their
    // own graph and republish — which puts the requester in `viewers` and
    // therefore makes users/{owner}/shared/{tier} readable to them, under
    // the isPublishedViewer() rule that has existed since 2026-08-18. So
    // the requester learns they were accepted by their EXISTING read
    // succeeding, and nobody has to write into anybody's account to say so.
    // No "accepted" flag, no reverse tombstone, no new permission.
    // ================================================================

    match /users/{userId}/requests/{fromUid} {
      // ⚠️ OWNER-ONLY READ, unlike invites. Nobody but the person being
      // asked may see who asked them, or what name they gave.
      allow get, list: if isOwner(userId);

      // ⚠️ THE DOCUMENT ID *IS* THE CALLER'S UID — the disconnects argument
      // verbatim: you may ask in your OWN name and nobody else's. Without
      // it, anybody could file a request appearing to come from anyone.
      // It also makes it idempotent: asking twice writes the same document,
      // so a retry cannot produce two rows for one person.
      //
      // `from` is checked against the caller too, so neither half can be
      // forged alone — the same belt-and-braces the handoff rule uses.
      allow create, update: if signedIn()
                            && fromUid == request.auth.uid
                            && request.resource.data.keys().hasOnly(['from', 'name', 'at'])
                            && 'from' in request.resource.data
                            && 'name' in request.resource.data
                            && 'at' in request.resource.data
                            && request.resource.data.from == request.auth.uid
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 60
                            && request.resource.data.at is timestamp;

      // The owner deletes it on accept or decline; the requester can take it
      // back before it is answered.
      allow delete: if isOwner(userId) || fromUid == request.auth.uid;
    }

    // ================================================================
    // 🚨 THE PUBLIC DIRECTORY — and it is the ONE place in this file that
    // grants `list`. Read this before touching it.
    //
    // ⚠️ IT REVERSES A DECISION THIS PROJECT MADE ON PURPOSE. Every version
    // of this file before 2026-08-29 said, above the invites block: "There is
    // no user directory in v1, deliberately: a searchable list of accounts is
    // an enumeration surface that has to be right first time, and an invite
    // link is a capability handed to one person instead."
    //
    // ⚠️ AND THE OBJECTION IS NOT ANSWERED — IT IS ACCEPTED, WITH ITS PRICE
    // NAMED. Firestore rules cannot constrain a query's `where` clause:
    // `request.query` exposes only limit, offset and orderBy. There is no way
    // to write "you may query this collection only by exact name". Granting
    // `list` at all grants PAGINATED ENUMERATION OF EVERY ROW. So this
    // document deliberately holds the minimum that makes search work — a uid
    // and a display name the user chose to publish — and nothing else. No
    // email, ever (docs/social-plan.md §3.5), no photo, no training.
    //
    // ⚠️ WHAT AN ATTACKER GAINS: the complete list of display names paired
    // with uids. A uid was previously learnable only from a link somebody
    // handed you. What that unlocks is bounded — every private path is still
    // isOwner, every projection is still isPublishedViewer, and a denied read
    // is indistinguishable from a missing document — but it does mean the
    // `disconnects` and `requests` writes above, whose residual safety was
    // partly uid unguessability, can now be aimed at any account. Both are
    // shape-checked, id-pinned to the caller, and no-ops on the receiving
    // client if they name somebody not in the graph.
    //
    // ⚠️ TIM DECIDED THIS, 2026-08-29, told the above: *"Right now the website
    // has less than 5 users so just do the name search to keep it easy for
    // now and then we can work on making a different version eventually."*
    // The narrowed version that keeps the old invariant is a HANDLE directory
    // with get-yes / list-no — exact lookup by a handle you chose, no `list`
    // anywhere, so nothing is enumerable. docs/social-plan.md §3.4 already
    // blesses that shape. It is the thing to build when "eventually" arrives,
    // and this block should be deleted the day it does.
    //
    // ⚠️ LISTING IS OPT-OUT IN THE APP (Settings → Findable by name). The
    // rules cannot enforce that — a client can always write its own row —
    // which is exactly why it is a client-side courtesy and is described as
    // one rather than as a protection.
    // ================================================================

    match /directory/{uid} {
      // The whole point, and the whole cost. See above.
      allow get, list: if signedIn();

      // ⚠️ Your own row and nobody else's — the id is the access control, the
      // same shape as requests and disconnects. Shape-checked so the document
      // cannot grow fields nobody audited: a directory row that can carry
      // arbitrary keys is a directory row somebody puts an email in.
      allow create, update: if signedIn()
                            && uid == request.auth.uid
                            && request.resource.data.keys().hasOnly(['uid', 'name', 'nameLower', 'updatedAt'])
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 60
                            && request.resource.data.nameLower is string
                            && request.resource.data.nameLower.size() <= 60
                            && request.resource.data.updatedAt is timestamp;

      // Turning listing off, and deleting an account, both remove the row.
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    /* ================================================================== *
     * NOTES TO THE DEVELOPER — 2026-09-04
     * ================================================================== *
     *
     * Tim asked for a way for users to send him an idea or a problem from
     * inside the app, and for his own account to be able to read them there.
     *
     * 🚨 THIS IS THE SECOND TOP-LEVEL COLLECTION IN THE APP, AND THE FIRST THAT
     * IS NOT WORLD-READABLE. It is top-level for one reason: the developer has
     * to LIST every note, and notes filed under `users/{uid}/…` could only be
     * listed by first enumerating users — which is the thing the whole invite
     * design exists to avoid. A flat collection that exactly one uid may list is
     * strictly less surface than a users collection anybody may walk.
     *
     * 🚨 AND IT IS THE FIRST FREE TEXT ONE PERSON WRITES FOR ANOTHER TO READ.
     * Everything social so far is a projection of training somebody chose to
     * publish. A note is prose aimed at a human, so the read side is as narrow
     * as it can be made: ONE uid, hard-coded, and nobody — not even the author —
     * can read one back.
     *
     * ⚠️ WHY THE AUTHOR CANNOT READ THEIR OWN. It would be harmless and slightly
     * friendly, and it would mean the collection has a `get` rule whose
     * condition is a field inside the document. That is a shape where a mistake
     * is invisible: the rule looks right, and a document with a forged `uid`
     * reads somebody else's note. Create-only has no such shape. The screen
     * confirms the send instead.
     */
    function isDeveloper() {
      // ⚠️ DUPLICATED IN js/feedback.js AS `DEVELOPER_UID`, AND A TEST ASSERTS
      // THE TWO MATCH. This copy is the one that protects anything; the other
      // only decides whether a screen is drawn. If they ever disagree, the app
      // shows an inbox that the database refuses to fill — or, far worse, hides
      // one it would happily have answered.
      //
      // ⚠️ A uid, NOT AN EMAIL. request.auth.token.email depends on the provider
      // and can change; a uid is issued once and never moves. Same key every
      // other rule in this file uses.
      return signedIn() && request.auth.uid == '0WQLOAaP8DaRCTDMBSBbRM9haJq2';
    }

    function validNote() {
      // Shape-checked like the directory row, and for the same reason: a
      // document that may carry arbitrary keys is a document somebody puts
      // something unaudited in.
      return request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'platform', 'createdAt'])
             // The sender is the caller. Without this, anybody could file a note
             // under somebody else's uid, and the developer would answer the
             // wrong person about a complaint they never made.
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.text is string
             && request.resource.data.text.size() > 0
             // Matches MAX_NOTE in js/feedback.js. The client caps it too; this
             // is the copy that holds when the client is not ours.
             && request.resource.data.text.size() <= 1000
             && request.resource.data.name is string
             && request.resource.data.name.size() <= 60
             // The DEVICE, not an app version — see the note in js/feedback.js.
             // A user-agent string is long, so this cap is the loosest here.
             && request.resource.data.platform is string
             && request.resource.data.platform.size() <= 120
             && request.resource.data.createdAt is string
             && request.resource.data.createdAt.size() <= 40;
    }

    match /feedback/{noteId} {
      // Anybody signed in may send one, and that is the whole write surface.
      allow create: if signedIn() && validNote();

      // 🛑 NO UPDATE, FOR ANYBODY, INCLUDING THE DEVELOPER. A note is a record of
      // what somebody said; an edit path would let it become a record of what
      // somebody wishes they had said, and there is no version of this feature
      // that needs one.
      allow update: if false;

      // Exactly one account reads them, and it is the only account that can
      // discover they exist.
      allow get, list: if isDeveloper();

      // ⚠️ DELETE IS THE DEVELOPER'S ONLY, AND IT IS DELIBERATE THAT THE AUTHOR
      // CANNOT. Letting the sender delete would need a read of the existing
      // document to check ownership, which re-introduces exactly the
      // field-conditioned rule the note above rejects — and "I take it back"
      // is not a thing this channel needs to support for a couple of months.
      // Tim can clear anything he has dealt with, or anything unpleasant.
      allow delete: if isDeveloper();
    }

  }

}
